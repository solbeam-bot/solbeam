# SOLBEAM PoC configuration.
#
# Copy to .env and edit. NEVER commit .env — the existing .gitignore covers
# .env, *.key and *.pem.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a      # load into the shell
#
# These are regtest/local-validator values. None of them are secrets: the RPC
# user and password below guard a throwaway node on localhost only.

# --- SV Node (regtest) ------------------------------------------------------
SOLBEAM_RPC=http://127.0.0.1:18443
SOLBEAM_RPC_USER=solbeam
SOLBEAM_RPC_PASS=solbeam
SOLBEAM_RPCPORT=18443
SOLBEAM_DATADIR=$HOME/.solbeam/regtest

# --- Solana local validator ("Solana's regtest") ----------------------------
SOLBEAM_SOLANA_RPC=http://127.0.0.1:8899
SOLBEAM_SOLANA_WS=ws://127.0.0.1:8900

# --- Keys -------------------------------------------------------------------
# Directory for throwaway regtest/devnet keypairs. Outside the repo, and only
# test funds ever go in it.
SOLBEAM_KEYS=$HOME/.solbeam/keys

# --- Test harness -----------------------------------------------------------
# Run the checker suite as part of doctor.sh. Set to 0 to skip (it is fast, but
# it does touch the network for the two live-data checkers).
SOLBEAM_DOCTOR_RUN_CHECKS=1

# The regtest time scale, confirmation depth and deadlines are NOT set here.
# They live in exactly one place — poc/checks/bsvchain.py — because two sources
# of truth for a deadline is how a test matrix silently stops testing what you
# think it does. See TEST_PLAN.md §2.3.1.
